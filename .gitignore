# =============================================================
# Rora Studio - .gitignore
# =============================================================

### Java / Maven ###
target/
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
*.class
hs_err_pid*
replay_pid*
# El wrapper de Maven SI se versiona
!.mvn/wrapper/maven-wrapper.jar

### IDEs ###
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath
.apt_generated
.springBeans
.sts4-cache
nbproject/
nbbuild/
nbdist/
.nb-gradle/
.kotlin

### Sistema operativo ###
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

### Logs y temporales ###
*.log
/logs/
*.tmp
*.bak
*.swp
*~

### Empaquetado (jpackage / jlink / javafx-maven-plugin) ###
/build/
/dist/
# Herramientas fijadas por hash para tools/package-windows.ps1 (jmods de JavaFX, WiX)
/tools/.cache/
/installer/
*.msi
*.exe
*.dmg
*.deb
*.rpm

### Modelos de IA descargados (pesados, no se versionan) ###
/models/
*.onnx
*.pt
*.pth
*.safetensors
# Entorno de exportacion de modelos (fase 5)
/tools/models/.venv/
# Excepciones: el modelo incluido con la app (decision A1) y los modelos sinteticos de prueba
!/ai-engine/src/main/resources/io/github/erenriquezp/rora/ai/models/realesr-general-x4v3.onnx
!/ai-engine/src/main/resources/io/github/erenriquezp/rora/ai/models/face_detection_yunet_2023mar.onnx
!/ai-engine/src/test/resources/models/*.onnx

### Imágenes de prueba personales ###
samples-private/
test-images-private/
*.private.png
*.private.jpg

