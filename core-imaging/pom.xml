<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.erenriquezp</groupId>
        <artifactId>rora-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>rora-core-imaging</artifactId>
    <name>Rora Studio - core imaging</name>
    <description>Nucleo de procesamiento de imagen: sin JavaFX ni AWT en su API publica.</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Solo la compilacion de tests lee java.desktop (ver surefire) -->
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>java.desktop</arg>
                                <arg>--add-reads</arg>
                                <arg>io.github.erenriquezp.rora.core=java.desktop</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- El modulo solo requiere java.base. java.desktop se anade SOLO en tests, para
                         comparar Hsb con java.awt.Color de forma exhaustiva. -->
                    <argLine>@{argLine} -Djava.awt.headless=true -Dfile.encoding=UTF-8 --add-modules java.desktop --add-reads io.github.erenriquezp.rora.core=java.desktop</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
