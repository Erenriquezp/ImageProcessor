<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.erenriquezp</groupId>
        <artifactId>rora-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>rora-app</artifactId>
    <name>Rora Studio - app</name>

    <dependencies>
        <dependency>
            <groupId>io.github.erenriquezp</groupId>
            <artifactId>rora-core-imaging</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.erenriquezp</groupId>
            <artifactId>rora-imaging-io</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.erenriquezp</groupId>
            <artifactId>rora-ai-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-fontawesome6-pack</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Reglas de arquitectura (fase 2). Apache-2.0, verificado en su POM de Maven Central -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <!-- JavaFX 25 exige JDK 23 o superior; core-imaging sigue en 21 -->
        <maven.compiler.release>25</maven.compiler.release>
        <archunit.version>1.4.1</archunit.version>
    </properties>

    <profiles>
        <!-- Humo con el toolkit real; necesita pantalla (o xvfb-run). No entra en verify -->
        <profile>
            <id>ui-smoke</id>
            <properties>
                <test>StudioUiSmoke</test>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Desde la raiz: ./mvnw install -DskipTests && ./mvnw -pl app javafx:run -->
                        <id>default-cli</id>
                        <configuration>
                            <mainClass>io.github.erenriquezp.rora.app/io.github.erenriquezp.rora.app.shell.Launcher
                            </mainClass>
                            <launcher>app</launcher>
                            <jlinkZipName>app</jlinkZipName>
                            <jlinkImageName>app</jlinkImageName>
                            <noManPages>true</noManPages>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                            <options>
                                <!-- Silencia: java.lang.System::load (NativeLibLoader en javafx.graphics) -->
                                <option>--enable-native-access=javafx.graphics,com.microsoft.onnxruntime</option>
                                <!-- Nativos ya desempaquetados: ORT no debe extraer nada a %TEMP% -->
                                <option>-Donnxruntime.native.path=${ort.native.dir}</option>
                            </options>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
