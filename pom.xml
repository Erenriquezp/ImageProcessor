<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.erenriquezp</groupId>
    <artifactId>rora-parent</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Rora Studio (parent)</name>

    <modules>
        <module>core-imaging</module>
        <module>imaging-io</module>
        <module>wallpapers</module>
        <module>ai-engine</module>
        <module>app</module>
        <module>lab-plugin</module>
    </modules>

    <profiles>
        <!-- Benchmarks JMH fuera del build por defecto: ./mvnw -Pbench -pl bench -am package -DskipTests -->
        <profile>
            <id>bench</id>
            <modules>
                <module>bench</module>
            </modules>
        </profile>
        <!-- Plataforma de los nativos de ONNX Runtime; por defecto, win-x64 -->
        <profile>
            <id>ort-linux-x64</id>
            <activation>
                <os><name>linux</name><arch>amd64</arch></os>
            </activation>
            <properties><ort.platform>linux-x64</ort.platform></properties>
        </profile>
        <profile>
            <id>ort-osx-aarch64</id>
            <activation>
                <os><family>mac</family><arch>aarch64</arch></os>
            </activation>
            <properties><ort.platform>osx-aarch64</ort.platform></properties>
        </profile>
    </profiles>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Canal que muestra la app junto a la version ("0.1.0 (beta)"); la version es la del POM -->
        <rora.channel>beta</rora.channel>
        <maven.compiler.release>21</maven.compiler.release>
        <javafx.version>25.0.5</javafx.version>
        <atlantafx.version>2.1.0</atlantafx.version>
        <ikonli.version>12.4.0</ikonli.version>
        <!-- BSD (POM del proyecto). Solo lectura de WebP, en ejecucion -->
        <twelvemonkeys.version>3.15.3</twelvemonkeys.version>
        <junit.version>5.12.1</junit.version>
        <!-- Versiones de plugins de calidad (todos de codigo abierto) -->
        <compiler.version>3.13.0</compiler.version>
        <enforcer.version>3.5.0</enforcer.version>
        <surefire.version>3.6.1</surefire.version>
        <spotless.version>2.44.5</spotless.version>
        <google-java-format.version>1.28.0</google-java-format.version>
        <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
        <checkstyle.version>10.21.4</checkstyle.version>
        <spotbugs-plugin.version>4.10.5.0</spotbugs-plugin.version>
        <jacoco.version>0.8.14</jacoco.version>
        <!-- LGPL-3 (POM), solo en build -->
        <license-plugin.version>2.8.0</license-plugin.version>
        <assertj.version>3.27.3</assertj.version>
        <javafx-plugin.version>0.0.8</javafx-plugin.version>
        <dependency-plugin.version>3.7.0</dependency-plugin.version>
        <!-- MIT. SHA-256 del JAR fijado: d3f903af31fe8f01300adb6b2b67297aa5bee7895909afc32e76ef29a3921149
             (lo comprueba tools/jlink-check.sh; los nativos, OrtNative) -->
        <onnxruntime.version>1.31.0</onnxruntime.version>
        <ort.platform>win-x64</ort.platform>
        <ort.unpack.dir>${maven.multiModuleProjectDirectory}/ai-engine/target/ort-native</ort.unpack.dir>
        <ort.native.dir>${ort.unpack.dir}/ai/onnxruntime/native/${ort.platform}</ort.native.dir>
        <!-- Spotless solo comprueba el codigo cambiado desde esta referencia (ratchet).
             Local: develop. En CI se sobrescribe con -Dspotless.ratchet=origin/develop -->
        <spotless.ratchet>develop</spotless.ratchet>
        <!-- JaCoCo rellena argLine; el valor vacio evita un literal "@{argLine}" si se omite el agente -->
        <argLine></argLine>
        <!-- Permite -Dtest=Clase desde la raiz aunque un modulo no tenga esa clase -->
        <surefire.failIfNoSpecifiedTests>false</surefire.failIfNoSpecifiedTests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.erenriquezp</groupId>
                <artifactId>rora-core-imaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.erenriquezp</groupId>
                <artifactId>rora-imaging-io</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.erenriquezp</groupId>
                <artifactId>rora-wallpapers</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.erenriquezp</groupId>
                <artifactId>rora-ai-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.onnxruntime</groupId>
                <artifactId>onnxruntime</artifactId>
                <version>${onnxruntime.version}</version>
            </dependency>
            <dependency>
                <groupId>com.twelvemonkeys.imageio</groupId>
                <artifactId>imageio-webp</artifactId>
                <version>${twelvemonkeys.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.erenriquezp</groupId>
                <artifactId>rora-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.erenriquezp</groupId>
                <artifactId>rora-lab-plugin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <!-- MIT (POM y LICENSE del proyecto). La 3.0.0 esta compilada contra JavaFX 27 -->
            <dependency>
                <groupId>io.github.mkpaz</groupId>
                <artifactId>atlantafx-base</artifactId>
                <version>${atlantafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kordamp.ikonli</groupId>
                <artifactId>ikonli-javafx</artifactId>
                <version>${ikonli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kordamp.ikonli</groupId>
                <artifactId>ikonli-fontawesome6-pack</artifactId>
                <version>${ikonli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <!-- AWT sin pantalla; @{argLine} lo rellena el agente de JaCoCo -->
                        <argLine>@{argLine} -Djava.awt.headless=true -Dfile.encoding=UTF-8</argLine>
                        <trimStackTrace>false</trimStackTrace>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-maven-plugin</artifactId>
                    <version>${javafx-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer.version}</version>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        <!-- Listado de licencias: ./mvnw -B -DskipTests install && ./mvnw -B license:aggregate-add-third-party@third-party -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-plugin.version}</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>third-party</id>
                        <goals>
                            <goal>aggregate-add-third-party</goal>
                        </goals>
                        <phase>none</phase>
                        <configuration>
                            <outputDirectory>${project.basedir}</outputDirectory>
                            <thirdPartyFilename>THIRD_PARTY_LICENSES.md</thirdPartyFilename>
                            <excludedScopes>test,system,provided</excludedScopes>
                            <excludedGroups>io\.github\.erenriquezp</excludedGroups>
                            <fileTemplate>${project.basedir}/tools/third-party.ftl</fileTemplate>
                            <licenseMerges>
                                <licenseMerge>BSD-3-Clause|The BSD License|BSD-3-Clause license|BSD License 3</licenseMerge>
                                <licenseMerge>Apache-2.0|Apache License, Version 2.0|The Apache Software License, Version 2.0|Apache 2.0</licenseMerge>
                            </licenseMerges>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Formato: no se ejecuta en el build; usar "mvn spotless:check" (CI en modo informe) -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <!-- Solo se comprueba el codigo modificado desde la referencia; no se reformatea lo heredado -->
                    <ratchetFrom>${spotless.ratchet}</ratchetFrom>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                        </googleJavaFormat>
                    </java>
                </configuration>
            </plugin>
            <!-- Estilo: solo informe, no bloquea el build -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>google_checks.xml</configLocation>
                    <failOnViolation>false</failOnViolation>
                    <failsOnError>false</failsOnError>
                    <consoleOutput>false</consoleOutput>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Analisis de bugs: solo informe. Manual: "mvn compile spotbugs:check" (desde la 4.10 lee clases de Java 25) -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-plugin.version}</version>
                <configuration>
                    <failOnError>false</failOnError>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
